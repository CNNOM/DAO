<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.dao.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Форма для ввода данных -->
    <HBox alignment="CENTER" spacing="10">
        <Label text="Name:"/>
        <TextField fx:id="nameField" promptText="Product name" minWidth="150"/>

        <Label text="Quantity:"/>
        <TextField fx:id="quantityField" promptText="Quantity" minWidth="80"/>

        <Label text="Tag:"/>
        <TextField fx:id="tagField" promptText="Product tag" minWidth="150"/>
    </HBox>

    <!-- Кнопки управления -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="addButton" text="Add" onAction="#handleAdd" minWidth="80"/>
        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" minWidth="80"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" minWidth="80"/>
    </HBox>

    <!-- Таблица продуктов -->
    <TableView fx:id="productTable" minWidth="600" minHeight="300">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" minWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Name" minWidth="150"/>
            <TableColumn fx:id="quantityColumn" text="Quantity" minWidth="100"/>
            <TableColumn fx:id="tagColumn" text="Tag" minWidth="150"/>
            <TableColumn fx:id="statusColumn" text="Status" minWidth="150"/>
        </columns>
    </TableView>
</VBox>